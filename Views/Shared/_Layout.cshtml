<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Html.Encode(ViewData["Title"]) - Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f4f6fb;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            height: 100vh;
            overflow: hidden;
        }

        /* ================= SIDEBAR ================= */
        .sidebar {
            width: 80px; /* default collapsed width */
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: linear-gradient(135deg, #ff758c, #ff7eb3);
            border-right: 1px solid #eee;
            display: flex;
            flex-direction: column;
            padding-top: 20px;
            transition: width 0.3s ease;
            overflow: hidden;
            z-index: 1000;
        }

        /* Expand sidebar on hover */
        .sidebar:hover {
            width: 200px;
        }

        /* Logo */
        .sidebar .logo {
            font-size: 28px;
            color: #fff;
            text-align: center;
            margin-bottom: 32px;
            transition: all 0.3s;
        }

        /* Menu items */
        .sidebar .nav-item {
            display: flex;
            align-items: center;
            padding: 12px;
            margin-bottom: 10px;
            border-radius: 12px;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            transition: all 0.25s;
            position: relative;
        }

        /* Icon inside nav-item */
        .sidebar .nav-item i {
            min-width: 24px;
            text-align: center;
            font-size: 20px;
        }

        /* Text inside nav-item (hidden when collapsed) */
        .sidebar .nav-item span {
            margin-left: 12px;
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        /* Show text when sidebar expanded */
        .sidebar:hover .nav-item span {
            opacity: 1;
        }

        /* Hover effect */
        .sidebar .nav-item:hover {
            background: rgba(255,255,255,0.2);
        }

        /* Active menu item */
        .sidebar .nav-item.active {
            background: rgba(255,255,255,0.3);
            font-weight: bold;
        }

        /* Push settings to bottom */
        .sidebar .more {
            margin-top: auto;
            margin-bottom: 20px;
        }

        /* ================= MAIN CONTENT ================= */
        .main-content {
            margin-left: 80px;
            height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.3s ease;
        }

        /* Expand main content margin when sidebar expands */
        .sidebar:hover ~ .main-content {
            margin-left: 200px;
        }

        /* ================= TOPBAR ================= */
        .topbar {
            position: sticky;
            top: 0;
            background: pink;
            padding: 12px 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 100;
        }

        .search-box {
            max-width: 600px;
            width: 100%;
            height: 46px;
            background: #f1f1f1;
            border-radius: 30px;
            display: flex;
            align-items: center;
            padding: 0 18px;
        }

        .search-box i {
            color: #777;
            margin-right: 10px;
        }

        .search-box input {
            border: none;
            outline: none;
            background: transparent;
            width: 100%;
            font-size: 15px;
        }

        .topbar-icons i {
            font-size: 22px;
            margin-left: 22px;
            cursor: pointer;
            transition: all 0.25s;
        }

        .topbar-icons i:hover {
            color: #0d6efd;
            transform: scale(1.15);
        }

        /* ================= PAGE CONTENT ================= */
        .page-content {
            padding: 30px 40px;
            overflow-y: auto;
            flex: 1;
        }
    </style>
</head>
<body>

    <!-- ================= SIDEBAR ================= -->
    <div class="sidebar">

        <!-- Logo -->
        <a href="#" class="logo">
            <i class="fa-solid fa-feather"></i>
        </a>

        <!-- Menu Items -->
        <div class="nav-item active">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
        </div>

        <div class="nav-item">
            <i class="fa-solid fa-plus"></i>
            <span>Add New</span>
        </div>

        <div class="nav-item">
            <i class="fa-solid fa-user-group"></i>
            <span>Users</span>
        </div>

        <div class="nav-item">
            <i class="fa-solid fa-heart"></i>
            <span>Favorites</span>
        </div>

        <div class="nav-item">
            <i class="fa-regular fa-message"></i>
            <span>Messages</span>
        </div>

        <div class="nav-item more">
            <i class="fa-solid fa-gear"></i>
            <span>Settings</span>
        </div>

    </div>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="main-content">

        <!-- Topbar -->
        <div class="topbar">
            <div class="app-name">
                <h2>PIXORA</h2>
            </div>

            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search..." />
            </div>

            <div class="topbar-icons d-flex align-items-center">
                <i class="fa-regular fa-bell"></i>

                <div class="dropdown">
                    <i class="fa-solid fa-user dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="cursor:pointer;"></i>

                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li>
                            <a class="dropdown-item" href="/Admin/Users/Profile">
                                <i class="fa-solid fa-id-card me-2"></i> User Detail
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="/Auth/Login">
                                <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Page Body -->
        <div class="page-content">
            @RenderBody()
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
