@model List<MyAPI.Models.Users>

@{
    ViewData["Title"] = "User Management";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-4">
    <h3 class="mb-3">User Management</h3>

    <table class="table table-hover table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th width="80">ID</th>
                <th>Username</th>
                <th>Email</th>
                <th width="120">Status</th>
                <th width="150">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.user_name</td>
                    <td>@u.email</td>
                    <td>
                        <span class="badge @(u.is_active ? "bg-success" : "bg-danger")">
                            @(u.is_active ? "Active" : "Disabled")
                        </span>
                    </td>
                    <td>
                        <!-- EDIT -->
                        <button class="btn btn-warning btn-sm" onclick="openEdit(@u.Id)">
                            <i class="fa fa-pen"></i>
                        </button>

                        <!-- DELETE -->
                        <form asp-area="Admin"
                              asp-controller="Users"
                              asp-action="Delete"
                              asp-route-id="@u.Id"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this user?')">
                                <i class="fa fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- MODAL -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function openEdit(id) {
        $('#modalTitle').text('Edit User');
        $('#modalBody').load('/Admin/Users/Edit/' + id); // use /Edit/{id}
        $('#userModal').modal('show');
    }

    $(document).on('submit', '#userForm', function (e) {
        e.preventDefault();

        $.ajax({
            url: '/Admin/Users/Edit',
            type: 'POST',
            data: $(this).serialize(),
            success: function () {
                $('#userModal').modal('hide');
                location.reload();
            },
            error: function (res) {
                $('#modalBody').html(res.responseText);
            }
        });
    });
</script>
